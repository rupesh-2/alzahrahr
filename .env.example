# --- Database -------------------------------------------------------------
# Production (Vercel): a Turso database. Leave both empty locally to use a
# SQLite file at storage/app.sqlite.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Uploaded files ---------------------------------------------------------
# Production (Vercel): connecting a Blob store to the project sets BLOB_STORE_ID
# (or, for older connections, BLOB_READ_WRITE_TOKEN). Leave both empty locally
# to keep uploads in storage/uploads.
BLOB_STORE_ID=
# BLOB_READ_WRITE_TOKEN=
# Set to "private" if the Blob store was created with private access.
BLOB_ACCESS=public

# --- Admin ------------------------------------------------------------------
# Signs the admin session cookie. Generate one with: openssl rand -base64 48
SESSION_SECRET=

# The first admin account is created from these when the database has no users.
ADMIN_NAME="Kshitij Dhungana"
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Set to true (then redeploy) to create the ADMIN_EMAIL account if missing or reset
# its password to ADMIN_PASSWORD. Remove it again once you can sign in.
# ADMIN_RESET_PASSWORD=true

# --- Email ------------------------------------------------------------------
# Outgoing mail for the contact and apply forms. Leave SMTP_HOST empty to only
# log messages to the server console (like Laravel's MAIL_MAILER=log).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@alzahrahr.com
MAIL_FROM_NAME="Al Zahra HR website"
