# --- Database -------------------------------------------------------------
# Production (Vercel): a Turso database. Leave both empty locally to use a
# SQLite file at storage/app.sqlite.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Uploaded files ---------------------------------------------------------
# Production (Vercel): read-write token of a PUBLIC Vercel Blob store (set
# automatically when the store is connected to the project). Leave empty
# locally to keep uploads in storage/uploads.
BLOB_READ_WRITE_TOKEN=

# --- Admin ------------------------------------------------------------------
# Signs the admin session cookie. Generate one with: openssl rand -base64 48
SESSION_SECRET=

# The first admin account is created from these when the database has no users.
ADMIN_NAME="Kshitij Dhungana"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Email ------------------------------------------------------------------
# Outgoing mail for the contact and apply forms. Leave SMTP_HOST empty to only
# log messages to the server console (like Laravel's MAIL_MAILER=log).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@alzahrahr.com
MAIL_FROM_NAME="Al Zahra HR website"
